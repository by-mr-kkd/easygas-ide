{
  "name": "easygas-ide",
  "version": "1.0.1",
  "private": true,
  "description": "EasyGAS IDE — local AI coding app for Google Apps Script. Bring your own AI (API key or subscription CLI) and deploy to your own Google account.",
  "license": "SEE LICENSE IN LICENSE",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build && node scripts/check-trace.mjs",
    "start": "next start --hostname 127.0.0.1",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"tests/**/*.test.ts\"",
    "rulebook:build": "node scripts/rulebook-build.mjs",
    "rulebook:sign": "node scripts/rulebook-sign.mjs",
    "rulebook:keygen": "node scripts/rulebook-keygen.mjs",
    "desktop:build": "node scripts/build-desktop.mjs",
    "desktop:dir": "node scripts/build-desktop.mjs --dir"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@google/clasp": "^3.3.0",
    "@heroicons/react": "^2.2.0",
    "@monaco-editor/react": "^4.6.0",
    "next": "^15.5.27",
    "openai": "^6.42.0",
    "promptpay-qr": "^0.5.0",
    "qrcode": "^1.5.4",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.5.27",
    "pngjs": "^5.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.5.0"
  },
  "overrides": {
    "dompurify": "^3.4.16"
  }
}
